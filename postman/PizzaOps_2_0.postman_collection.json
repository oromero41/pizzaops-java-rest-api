{
  "info": {
    "name": "PizzaOps — REST API testing (Spring Boot + PostgreSQL)",
    "description": "Positive and negative API testing for PizzaOps. Default runtime stores orders in local PostgreSQL. The separate automated test profile uses in-memory storage.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 — Menu",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/menu",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "menu"
          ]
        },
        "description": "01 — Menu"
      },
      "response": []
    },
    {
      "name": "02 — Create order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "orders"
          ]
        },
        "description": "02 — Create order",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"size\": \"MEDIUM\",\n  \"base\": \"ORIGINAL\",\n  \"sauce\": \"TOMATO\",\n  \"cheese\": \"MOZZARELLA\",\n  \"toppings\": [\n    \"HAM\",\n    \"OLIVES\",\n    \"CHICKEN\",\n    \"BACON\",\n    \"PINEAPPLE\"\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"orderId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
